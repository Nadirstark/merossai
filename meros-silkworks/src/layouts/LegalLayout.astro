---
// Shared shell for the four placeholder-copy pages (§4.7): care,
// shipping-returns, privacy, terms. Each is noindex until its real content
// replaces the flagged placeholder — no reason to let search engines index
// draft legal text.
import BaseLayout from './BaseLayout.astro';

interface Props {
  seoTitle: string;
  seoDescription: string;
  title: string;
  flagMessage?: string;
}

const { seoTitle, seoDescription, title, flagMessage } = Astro.props;
---

<BaseLayout title={seoTitle} description={seoDescription} noindex>
  <div class="page">
    {flagMessage && <p class="page__flag">{flagMessage}</p>}
    <h1 class="page__title">{title}</h1>
    <div class="page__prose">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-16) var(--page-pad) var(--space-24);
  }

  .page__flag {
    display: inline-block;
    margin-bottom: var(--space-6);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    max-width: var(--measure);
  }

  .page__title {
    font-size: var(--text-display);
  }

  .page__prose {
    margin-top: var(--space-8);
    max-width: var(--measure);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .page__prose :global(h2) {
    font-size: var(--text-lg);
    margin-top: var(--space-4);
  }

  .page__prose :global(p) {
    color: var(--muted);
  }

  .page__prose :global(ul) {
    color: var(--muted);
    padding-left: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
</style>
