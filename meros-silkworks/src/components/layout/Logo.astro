---
// §5 layout component. Real hand-drawn wordmark (replaces the former text
// logotype now that Saida's actual logo file exists). The image sits on a
// white background; --canvas is near-white too, so no visible seam.
import { Image } from 'astro:assets';
import logoImage from '../../assets/logo/meros-logo.png';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a href="/" class:list={['logo', className]} aria-label="Meros Silkworks — home">
  <Image src={logoImage} alt="" width={936} height={581} loading="eager" class="logo__image" />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    transition: opacity var(--dur-1) var(--ease);
  }

  .logo__image {
    display: block;
    height: 76px;
    width: auto;
  }

  .logo:hover,
  .logo:focus-visible {
    opacity: 0.7;
  }

  @media (max-width: 26rem) {
    .logo__image {
      height: 60px;
    }
  }
</style>
