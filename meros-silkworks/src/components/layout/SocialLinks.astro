---
// §5 layout component. Plain text links — matches Nav's typographic
// treatment rather than sourcing brand iconography.
interface SocialLink {
  label: string;
  href: string;
}

interface Props {
  class?: string;
}

const links: SocialLink[] = [
  { label: 'Instagram', href: 'https://instagram.com/merossilkworks' },
  { label: 'Etsy shop', href: 'https://etsy.com/shop/MerosSilkworks' },
];

const { class: className } = Astro.props;
---

<ul class:list={['social', className]}>
  {
    links.map((link) => (
      <li>
        <a href={link.href} class="social__link" target="_blank" rel="noopener noreferrer">
          {link.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .social__link {
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease);
  }

  .social__link:hover,
  .social__link:focus-visible {
    color: var(--accent-ink);
  }
</style>
