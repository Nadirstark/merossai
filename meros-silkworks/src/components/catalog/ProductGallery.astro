---
// §5 catalog component. Etsy-style layout: a vertical thumbnail rail
// (tablet/desktop) or a below-the-fold row (mobile) drives which image
// shows in the main stage, independent of the Lightbox. Every image is
// pre-rendered at "main" size as its own stage slide (like Lightbox's own
// slides) so swapping is a client-side `hidden` toggle, not a re-fetch —
// this is a static site, there's no server to ask for a bigger version
// on click. Clicking the visible main image still opens the full-screen
// Lightbox at that same index.
import ImageBleed from '../system/Image.astro';
import Lightbox from './Lightbox.astro';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  type: 'primary' | 'onbody' | 'detail';
}

interface Props {
  images: GalleryImage[];
  idPrefix?: string;
  class?: string;
}

const { images, idPrefix = 'gallery', class: className } = Astro.props;
const main = images[0];
---

<div class:list={['gallery', className]}>
  <div class="gallery__thumbs">
    {
      images.map((image, i) => (
        <button
          type="button"
          class="gallery__thumb"
          data-gallery-thumb
          aria-current={i === 0 ? 'true' : undefined}
          aria-label={`Show image ${i + 1} of ${images.length}: ${image.alt}`}
        >
          <ImageBleed
            src={image.src}
            alt=""
            width={400}
            height={image.type === 'detail' ? 400 : 500}
            class="gallery__image"
          />
        </button>
      ))
    }
  </div>

  <div class="gallery__stage">
    {
      images.map((image, i) => (
        <div class="gallery__slide" data-gallery-slide hidden={i !== 0}>
          <button
            type="button"
            class="gallery__main"
            data-lightbox-open={idPrefix}
            data-lightbox-index={i}
            aria-label={`View larger: ${image.alt}`}
          >
            <ImageBleed
              src={image.src}
              alt={image.alt}
              width={900}
              height={image.type === 'detail' ? 900 : 1125}
              class="gallery__image"
            />
          </button>
        </div>
      ))
    }
  </div>
</div>

<Lightbox id={idPrefix} label={`${main.alt} — full-size gallery`} images={images} />

<style>
  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .gallery__stage {
    order: -1;
  }

  .gallery__slide[hidden] {
    display: none;
  }

  .gallery__main,
  .gallery__thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .gallery__main {
    aspect-ratio: 4 / 5;
  }

  .gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .gallery__thumb {
    aspect-ratio: 4 / 5;
    flex-shrink: 0;
    opacity: 0.6;
    transition: opacity var(--dur-1) var(--ease);
  }

  .gallery__thumb:hover,
  .gallery__thumb:focus-visible {
    opacity: 1;
  }

  .gallery__thumb[aria-current='true'] {
    opacity: 1;
    box-shadow: var(--focus-ring);
  }

  /* :global() required — ImageBleed renders this element in its own
     scoped boundary. Harmless no-op today (plain block boxes fill their
     container's width by default, so sizing looks right by coincidence),
     but written correctly rather than left as dead, misleading CSS. */
  .gallery__main :global(.gallery__image),
  .gallery__thumb :global(.gallery__image) {
    width: 100%;
    height: 100%;
  }

  @media (min-width: 48rem) {
    .gallery {
      flex-direction: row;
      /* flex-start, not stretch: the stage's height comes from its own
         aspect-ratio, not from matching the thumb rail. With stretch, a
         product with many images would pull the stage's height up to the
         rail's full (unscrolled) content height, leaving dead space below
         the actual photo. The rail gets a height cap of its own instead
         and scrolls internally when there are more thumbs than fit. */
      align-items: flex-start;
      gap: var(--space-4);
    }

    .gallery__stage {
      order: 0;
      flex: 1;
      min-width: 0;
    }

    .gallery__thumbs {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      width: 5.5rem;
      flex-shrink: 0;
      max-height: 34rem;
      overflow-y: auto;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.gallery').forEach((gallery) => {
    const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]'));
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]'));

    thumbs.forEach((thumb, index) => {
      thumb.addEventListener('click', () => {
        slides.forEach((slide, i) => {
          slide.hidden = i !== index;
        });
        thumbs.forEach((t, i) => {
          if (i === index) t.setAttribute('aria-current', 'true');
          else t.removeAttribute('aria-current');
        });
      });
    });
  });
</script>
