---
// §5 catalog component. Newest / Price low-high / Price high-low (§4.2).
// Plain <form method="get"> works with JS disabled via the Apply button;
// the inline script progressively enhances it to auto-submit on change.
interface SortOption {
  label: string;
  value: string;
}

interface Props {
  value?: string;
  class?: string;
}

const OPTIONS: SortOption[] = [
  { label: 'Newest', value: 'newest' },
  { label: 'Price: low to high', value: 'price-asc' },
  { label: 'Price: high to low', value: 'price-desc' },
];

const { value = 'newest', class: className } = Astro.props;
---

<form class:list={['sort-select', className]} method="get" data-sort-form>
  <label for="sort" class="sort-select__label">Sort</label>
  <select id="sort" name="sort" class="sort-select__control">
    {
      OPTIONS.map((option) => (
        <option value={option.value} selected={option.value === value}>
          {option.label}
        </option>
      ))
    }
  </select>
  <button type="submit" class="sort-select__apply">Apply</button>
</form>

<style>
  .sort-select {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .sort-select__label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--muted);
  }

  .sort-select__control {
    appearance: none;
    padding: var(--space-2) var(--space-6) var(--space-2) var(--space-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background-color: var(--canvas);
    color: var(--ink);
    font-size: var(--text-sm);
    font-family: inherit;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--muted) 50%),
      linear-gradient(135deg, var(--muted) 50%, transparent 50%);
    background-position:
      calc(100% - 14px) center,
      calc(100% - 9px) center;
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
  }

  .sort-select__apply {
    padding: var(--space-1);
    border: none;
    background: none;
    color: var(--muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }
</style>

<script>
  document.querySelectorAll('[data-sort-form]').forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;
    const select = form.querySelector('select');
    if (!select) return;
    select.addEventListener('change', () => form.requestSubmit());
  });
</script>
