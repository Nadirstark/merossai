---
// §5 forms component. Single email field (§4.1). `compact` is the
// shorter variant for the Footer's `newsletter` slot (§5 Footer).
// action="#" is a placeholder — the real ESP is a Phase 2 decision (§1.3).
import Button from '../system/Button.astro';

interface Props {
  compact?: boolean;
  class?: string;
}

const { compact = false, class: className } = Astro.props;
const fieldId = compact ? 'newsletter-email-compact' : 'newsletter-email';
---

<form class:list={['newsletter', compact && 'newsletter--compact', className]} action="#" method="post">
  {!compact && <p class="newsletter__copy">New pieces and restocks. A few times a year.</p>}
  <div class="newsletter__row">
    <label for={fieldId} class:list={['newsletter__label', compact && 'sr-only']}>Email</label>
    <input
      id={fieldId}
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      required
      placeholder="Email address"
      class="newsletter__input"
    />
    <Button type="submit" class="newsletter__submit">Sign up</Button>
  </div>
</form>

<style>
  .newsletter__copy {
    color: var(--muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
    max-width: 32ch;
  }

  .newsletter__row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .newsletter__label {
    display: block;
    flex-basis: 100%;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-2);
  }

  .newsletter__input {
    flex: 1 1 14rem;
    min-width: 0;
    padding: var(--space-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--canvas);
    color: var(--ink);
    font-size: var(--text-sm);
    font-family: inherit;
  }

  .newsletter__input::placeholder {
    color: var(--muted);
  }

  .newsletter--compact :global(.btn) {
    padding: var(--space-3) var(--space-4);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
