---
// §5 system component. Renders <a> when `href` is set, otherwise <button>,
// so a single component covers both "Buy on Etsy" (external link) and
// in-page form actions without duplicating markup at call sites.
interface Props {
  href?: string;
  variant?: 'solid' | 'outline';
  external?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const {
  href,
  variant = 'solid',
  external = href ? /^https?:\/\//.test(href) : false,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const tagProps = href
  ? {
      href,
      target: external ? '_blank' : undefined,
      rel: external ? 'noopener noreferrer' : undefined,
    }
  : { type };
---

<Tag class:list={['btn', `btn--${variant}`, className]} {...tagProps} {...rest}>
  <span class="btn__label"><slot /></span>
  {
    external && (
      <svg class="btn__arrow" width="11" height="11" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
        <path
          d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease);
  }

  .btn--solid {
    background: var(--ink);
    color: var(--canvas);
  }

  .btn--solid:hover,
  .btn--solid:focus-visible {
    background: var(--accent-ink);
    border-color: var(--accent-ink);
  }

  .btn--outline {
    background: transparent;
    color: var(--ink);
  }

  .btn--outline:hover,
  .btn--outline:focus-visible {
    background: var(--ink);
    color: var(--canvas);
  }

  .btn__arrow {
    flex-shrink: 0;
  }
</style>
