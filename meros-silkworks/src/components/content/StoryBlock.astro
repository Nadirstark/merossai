---
// §5 content component. Eyebrow + title + body slot + optional "read more"
// link — reused for the About teaser and Craft teaser (§4.1).
interface Props {
  eyebrow?: string;
  title: string;
  href?: string;
  linkLabel?: string;
  class?: string;
}

const { eyebrow, title, href, linkLabel = 'Read more', class: className } = Astro.props;
---

<section class:list={['story-block', className]}>
  {eyebrow && <p class="story-block__eyebrow">{eyebrow}</p>}
  <h2 class="story-block__title">{title}</h2>
  <div class="story-block__body">
    <slot />
  </div>
  {
    href && (
      <a href={href} class="story-block__link">
        {linkLabel}
        <svg width="11" height="11" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
          <path
            d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    )
  }
</section>

<style>
  .story-block__eyebrow {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent-ink);
    margin-bottom: var(--space-2);
  }

  .story-block__title {
    font-size: var(--text-h2);
  }

  .story-block__body {
    margin-top: var(--space-4);
    color: var(--muted);
    max-width: var(--measure);
  }

  .story-block__body :global(p + p) {
    margin-top: var(--space-4);
  }

  .story-block__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: var(--accent-ink);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-decoration: none;
  }

  .story-block__link:hover,
  .story-block__link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
