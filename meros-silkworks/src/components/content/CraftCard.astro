---
// §5 content component. Card for the /craft index grid (§4.5).
import type { CollectionEntry } from 'astro:content';
import ImageBleed from '../system/Image.astro';

interface Props {
  post: CollectionEntry<'craft'>;
  class?: string;
}

const { post, class: className } = Astro.props;
const { title, excerpt, coverImage, publishedAt } = post.data;
const formattedDate = publishedAt.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<a href={`/craft/${post.id}`} class:list={['craft-card', className]}>
  <span class="craft-card__media">
    <ImageBleed src={coverImage} alt={title} width={600} height={450} class="craft-card__image" />
  </span>
  <span class="craft-card__meta">{formattedDate}</span>
  <span class="craft-card__title">{title}</span>
  <span class="craft-card__excerpt">{excerpt}</span>
</a>

<style>
  .craft-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: inherit;
    text-decoration: none;
  }

  .craft-card__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--rule);
  }

  /* :global() required — ImageBleed renders this element in its own
     scoped boundary, so a bare selector never reaches it. */
  .craft-card__media :global(.craft-card__image) {
    width: 100%;
    height: 100%;
  }

  .craft-card__meta {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--muted);
  }

  .craft-card__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--display-weight);
    color: var(--ink);
  }

  .craft-card__excerpt {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }
</style>
