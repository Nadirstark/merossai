---
// §5 content component. Full-bleed image + tagline overlay (§4.1) — lead
// with the fabric, not a model.
//
// Deliberately does NOT use system/Image's 4-edge feather: that treatment
// is built for framed card imagery, and fading the left/right edges of a
// viewport-spanning hero would just look broken. Instead only the bottom
// edge dissolves — the "section transition" use of the bleed motif named
// explicitly in §7 — so the hero still resolves into the page below it
// using the same --feather value as everywhere else.
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  class?: string;
}

const { image, alt, class: className } = Astro.props;
---

<section class:list={['hero', className]}>
  <Image src={image} alt={alt} width={2400} height={1500} class="hero__image" />
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__content">
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 70vh;
    overflow: hidden;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-mask-image: linear-gradient(to bottom, black calc(100% - var(--feather)), transparent);
    mask-image: linear-gradient(to bottom, black calc(100% - var(--feather)), transparent);
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--ink) 55%, transparent), transparent 55%);
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-12) var(--page-pad) var(--space-16);
    color: var(--canvas);
  }
</style>
