---
// §5 content component. Star rating + quote + attributed author linking
// back to the Etsy review source (§4.1: "2–3 pulled from Etsy, with
// attribution").
import type { CollectionEntry } from 'astro:content';

interface Props {
  review: CollectionEntry<'reviews'>;
  class?: string;
}

const { review, class: className } = Astro.props;
const { quote, author, rating, sourceUrl } = review.data;
const stars = Array.from({ length: 5 }, (_, i) => i < rating);
---

<figure class:list={['review-quote', className]}>
  <div class="review-quote__stars" role="img" aria-label={`${rating} out of 5 stars`}>
    {
      stars.map((filled) => (
        <svg
          width="14"
          height="14"
          viewBox="0 0 16 16"
          aria-hidden="true"
          focusable="false"
          class:list={['review-quote__star', filled && 'review-quote__star--filled']}
        >
          <path
            d="M8 1.5l1.98 4.13 4.52.62-3.27 3.24.79 4.51L8 11.9l-4.02 2.1.79-4.51L1.5 6.25l4.52-.62L8 1.5z"
            fill={filled ? 'currentColor' : 'none'}
            stroke="currentColor"
            stroke-width="1"
            stroke-linejoin="round"
          />
        </svg>
      ))
    }
  </div>
  <blockquote class="review-quote__quote">
    <p>“{quote}”</p>
  </blockquote>
  <figcaption class="review-quote__author">
    <a href={sourceUrl} target="_blank" rel="noopener noreferrer">{author} on Etsy</a>
  </figcaption>
</figure>

<style>
  .review-quote {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .review-quote__stars {
    display: flex;
    gap: var(--space-1);
  }

  .review-quote__star {
    color: var(--muted);
  }

  .review-quote__star--filled {
    color: var(--accent-ink);
  }

  .review-quote__quote p {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--display-weight);
    font-variation-settings: var(--display-variation);
    line-height: var(--leading-tight);
    color: var(--ink);
    max-width: var(--measure);
  }

  .review-quote__author {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .review-quote__author a {
    color: inherit;
    text-decoration: none;
  }

  .review-quote__author a:hover,
  .review-quote__author a:focus-visible {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
