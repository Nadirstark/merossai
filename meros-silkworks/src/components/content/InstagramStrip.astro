---
// §5 content component. Static-curated grid of image+link pairs (§4.1).
// Deliberately NOT a live embed widget — no third-party script, no runtime
// API call, just images picked and dropped in by hand.
import ImageBleed from '../system/Image.astro';

interface InstagramPost {
  image: ImageMetadata;
  alt: string;
  href: string;
}

interface Props {
  posts: InstagramPost[];
  handle?: string;
  class?: string;
}

const { posts, handle = 'merossilkworks', class: className } = Astro.props;
---

<div class:list={['instagram-strip', className]}>
  <div class="instagram-strip__grid">
    {
      posts.map((post) => (
        <a href={post.href} class="instagram-strip__item" target="_blank" rel="noopener noreferrer">
          <ImageBleed src={post.image} alt={post.alt} width={400} height={400} class="instagram-strip__image" />
        </a>
      ))
    }
  </div>
  <a
    href={`https://instagram.com/${handle}`}
    class="instagram-strip__handle"
    target="_blank"
    rel="noopener noreferrer"
  >
    @{handle} on Instagram
  </a>
</div>

<style>
  .instagram-strip__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }

  .instagram-strip__item {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .instagram-strip__image {
    width: 100%;
    height: 100%;
    transition: opacity var(--dur-1) var(--ease);
  }

  .instagram-strip__item:hover .instagram-strip__image,
  .instagram-strip__item:focus-visible .instagram-strip__image {
    opacity: 0.85;
  }

  .instagram-strip__handle {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }

  .instagram-strip__handle:hover,
  .instagram-strip__handle:focus-visible {
    color: var(--accent-ink);
  }

  @media (min-width: 40rem) {
    .instagram-strip__grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }
</style>
