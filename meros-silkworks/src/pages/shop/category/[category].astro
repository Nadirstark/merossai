---
// One route per category, generated from the schema's enum (§3, §4.2) —
// not derived from which products happen to exist, so a category that
// temporarily has zero products still gets a real page and empty-state
// rather than a 404.
import { getCollection } from 'astro:content';
import { CATEGORIES, CATEGORY_LABELS, type Category } from '../../../content.config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FilterBar from '../../../components/catalog/FilterBar.astro';
import ProductGrid from '../../../components/catalog/ProductGrid.astro';
import Button from '../../../components/system/Button.astro';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category } }));
}

const { category } = Astro.params as { category: Category };
const categoryLabel = CATEGORY_LABELS[category];

const products = (await getCollection('products'))
  .filter((product) => product.data.category === category)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
  title={`${categoryLabel} — Shop — Meros Silkworks`}
  description={`Handmade ${categoryLabel.toLowerCase()} cut from handwoven Uzbek atlas ikat silk.`}
>
  <div class="page">
    <header class="page__header">
      <h1 class="page__title">{categoryLabel}</h1>
    </header>

    <FilterBar activeCategory={category} />

    {
      products.length === 0 ? (
        <div class="empty-state">
          <p class="empty-state__message">
            This category is fully spoken for right now — check back soon, or let's make something new.
          </p>
          <Button href="/custom">Start a custom request</Button>
        </div>
      ) : (
        <ProductGrid products={products} />
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--page-max);
    margin-inline: auto;
    /* No bottom padding: Footer supplies its own space-24 top margin, so
       adding one here would double the gap above it. */
    padding: var(--space-16) var(--page-pad) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .page__title {
    font-size: var(--text-display);
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-12) 0;
  }

  .empty-state__message {
    color: var(--muted);
    max-width: var(--measure);
  }
</style>
