---
// Contact — §4.7: form + Instagram + response-time expectation.
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import SocialLinks from '../components/layout/SocialLinks.astro';
---

<BaseLayout title="Contact — Meros Silkworks" description="Get in touch with Meros Silkworks.">
  <div class="page">
    <header class="page__header">
      <h1 class="page__title">Contact</h1>
      <p class="page__intro">
        Questions about an order, a custom piece, or anything else — usually get back to you within
        2–3 days. For anything time-sensitive, like an event date, an Instagram DM tends to get a
        faster reply.
      </p>
    </header>

    <div class="contact-layout">
      <ContactForm />
      <div class="contact-social">
        <h2 class="contact-social__heading">Find us elsewhere</h2>
        <SocialLinks />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-16) var(--page-pad) var(--space-24);
  }

  .page__title {
    font-size: var(--text-display);
  }

  .page__intro {
    margin-top: var(--space-4);
    color: var(--muted);
    max-width: var(--measure);
  }

  .contact-layout {
    margin-top: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .contact-social__heading {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  @media (min-width: 48rem) {
    .contact-layout {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-16);
    }
  }
</style>
